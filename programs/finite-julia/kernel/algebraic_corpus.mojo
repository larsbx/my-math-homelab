# algebraic_corpus.mojo
#
# Specification: docs/rational-interval-arithmetic-spec.md.
#
# GENERATED by tools/make_regime_ledger.py from reference/algebraic_corpus.py.
# Do not edit; `make_regime_ledger.py --check` fails the build on a hand edit.
#
# The algebraic corpus as root handles: an integer polynomial and a rational
# box per row, with the row's period and its declared trap.
# kernel/algebraic_parameter.mojo checks each polynomial is an exact-period
# Gleason factor (exact division and the Bezout certificates below), each box
# isolates a root (Krawczyk), and each trap is a trap on the whole box.

from finite_exact.closed_interval import ComplexIQ, IQ
from finite_exact.rat_q import Q

comptime ALGEBRAIC_SIZE = 5


struct AlgebraicRow(Copyable):
    """One root handle: coefficients in `c`, constant first, and an isolating box."""

    var key: String
    var coefficients: List[Int]
    var box: ComplexIQ
    var period: Int
    var trap: ComplexIQ
    var conjugate_of: String

    def __init__(
        out self,
        key: String,
        var coefficients: List[Int],
        box: ComplexIQ,
        period: Int,
        trap: ComplexIQ,
        conjugate_of: String,
    ):
        self.key = key
        self.coefficients = coefficients^
        self.box = box.copy()
        self.period = period
        self.trap = trap.copy()
        self.conjugate_of = conjugate_of


struct BezoutCertificate(Copyable):
    """`a p + b f_c^d(0) = n` with `n` a nonzero integer: `p` shares no root with `f_c^d(0)`."""

    var divisor: Int
    var a: List[Int]
    var b: List[Int]
    var n: Int

    def __init__(out self, divisor: Int, var a: List[Int], var b: List[Int], n: Int):
        self.divisor = divisor
        self.a = a^
        self.b = b^
        self.n = n


def algebraic_row(index: Int) -> AlgebraicRow:
    if index == 0:
        var coefficients: List[Int] = [1, 1, 2, 1]
        return AlgebraicRow(
            "rabbit",
            coefficients^,
            ComplexIQ(IQ(Q(-269514856191, 2199023255552), Q(-269514856187, 2199023255552)), IQ(Q(818984173483, 1099511627776), Q(818984173485, 1099511627776))),
            3,
            ComplexIQ(IQ(Q(-1, 64), Q(1, 64)), IQ(Q(-1, 64), Q(1, 64))),
            "",
        )
    if index == 1:
        var coefficients: List[Int] = [1, 1, 2, 1]
        return AlgebraicRow(
            "co_rabbit",
            coefficients^,
            ComplexIQ(IQ(Q(-269514856191, 2199023255552), Q(-269514856187, 2199023255552)), IQ(Q(-818984173485, 1099511627776), Q(-818984173483, 1099511627776))),
            3,
            ComplexIQ(IQ(Q(-1, 64), Q(1, 64)), IQ(Q(-1, 64), Q(1, 64))),
            "rabbit",
        )
    if index == 2:
        var coefficients: List[Int] = [1, 1, 2, 1]
        return AlgebraicRow(
            "airplane",
            coefficients^,
            ComplexIQ(IQ(Q(-3859016798727, 2199023255552), Q(-3859016798723, 2199023255552)), IQ(Q(-1, 1099511627776), Q(1, 1099511627776))),
            3,
            ComplexIQ(IQ(Q(-1, 64), Q(1, 64)), IQ(Q(-1, 64), Q(1, 64))),
            "",
        )
    if index == 3:
        var coefficients: List[Int] = [1, 0, 2, 3, 3, 3, 1]
        return AlgebraicRow(
            "kokopelli",
            coefficients^,
            ComplexIQ(IQ(Q(-21511967927, 137438953472), Q(-86047871707, 549755813888)), IQ(Q(567483849499, 549755813888), Q(141870962375, 137438953472))),
            4,
            ComplexIQ(IQ(Q(-1, 64), Q(1, 64)), IQ(Q(-1, 64), Q(1, 64))),
            "",
        )
    if index == 4:
        var coefficients: List[Int] = [1, 0, 2, 3, 3, 3, 1]
        return AlgebraicRow(
            "kokopelli_conjugate",
            coefficients^,
            ComplexIQ(IQ(Q(-21511967927, 137438953472), Q(-86047871707, 549755813888)), IQ(Q(-141870962375, 137438953472), Q(-567483849499, 549755813888))),
            4,
            ComplexIQ(IQ(Q(-1, 64), Q(1, 64)), IQ(Q(-1, 64), Q(1, 64))),
            "kokopelli",
        )
    var none = List[Int]()
    return AlgebraicRow("", none^, ComplexIQ.singleton(Q(1, 0), Q(1, 0)), 0, ComplexIQ.singleton(Q(1, 0), Q(1, 0)), "")


def certificate_count(index: Int) -> Int:
    if index == 0:
        return 1
    if index == 1:
        return 1
    if index == 2:
        return 1
    if index == 3:
        return 2
    if index == 4:
        return 2
    return 0


def bezout_certificate(index: Int, j: Int) -> BezoutCertificate:
    if index == 0 and j == 0:
        var a: List[Int] = [1]
        var b: List[Int] = [-1, -2, -1]
        return BezoutCertificate(1, a^, b^, 1)
    if index == 1 and j == 0:
        var a: List[Int] = [1]
        var b: List[Int] = [-1, -2, -1]
        return BezoutCertificate(1, a^, b^, 1)
    if index == 2 and j == 0:
        var a: List[Int] = [1]
        var b: List[Int] = [-1, -2, -1]
        return BezoutCertificate(1, a^, b^, 1)
    if index == 3 and j == 0:
        var a: List[Int] = [1]
        var b: List[Int] = [0, -2, -3, -3, -3, -1]
        return BezoutCertificate(1, a^, b^, 1)
    if index == 3 and j == 1:
        var a: List[Int] = [1]
        var b: List[Int] = [0, -2, -1, -2, -1]
        return BezoutCertificate(2, a^, b^, 1)
    if index == 4 and j == 0:
        var a: List[Int] = [1]
        var b: List[Int] = [0, -2, -3, -3, -3, -1]
        return BezoutCertificate(1, a^, b^, 1)
    if index == 4 and j == 1:
        var a: List[Int] = [1]
        var b: List[Int] = [0, -2, -1, -2, -1]
        return BezoutCertificate(2, a^, b^, 1)
    var none = List[Int]()
    var empty = List[Int]()
    return BezoutCertificate(0, none^, empty^, 0)
