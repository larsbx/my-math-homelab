# parameter_corpus.mojo
#
# Specification: docs/rational-interval-arithmetic-spec.md.
#
# GENERATED by tools/make_regime_ledger.py from reference/parameter_corpus.py.
# Do not edit; `make_regime_ledger.py --check` fails the build on a hand edit.
#
# The corpus as exact Int64 numerator/denominator pairs, with the verdict each
# row must produce. kernel/corpus_replay.mojo checks the Mojo kernel against it,
# and tests/test_mojo_replay.py checks that transcript against the Python
# reference oracle, so the two implementations cannot drift apart silently.

from finite_exact.closed_interval import ComplexIQ
from julia_orbit import (
    MULT_IRRATIONALLY_INDIFFERENT,
    MULT_NONE,
    MULT_PARABOLIC,
    MULT_REPELLING,
    MULT_SUPERATTRACTING,
    ORBIT_CAPPED,
    ORBIT_ESCAPES,
    ORBIT_PREPERIODIC,
    gaussian_q,
)

alias CORPUS_SIZE = 10
alias MOJO_HORIZON = 8


struct CorpusRow(Copyable):
    """One parameter, its witness, and the verdict the kernel must return."""

    var key: String
    var c: ComplexIQ
    var cycle_length: Int
    var cycle_a: ComplexIQ
    var cycle_b: ComplexIQ
    var multiplier_class: Int
    var orbit_kind: Int
    var orbit_index_a: Int
    var orbit_index_b: Int

    def __init__(
        out self,
        key: String,
        c: ComplexIQ,
        cycle_length: Int,
        cycle_a: ComplexIQ,
        cycle_b: ComplexIQ,
        multiplier_class: Int,
        orbit_kind: Int,
        orbit_index_a: Int,
        orbit_index_b: Int,
    ):
        self.key = key
        self.c = c.copy()
        self.cycle_length = cycle_length
        self.cycle_a = cycle_a.copy()
        self.cycle_b = cycle_b.copy()
        self.multiplier_class = multiplier_class
        self.orbit_kind = orbit_kind
        self.orbit_index_a = orbit_index_a
        self.orbit_index_b = orbit_index_b


def corpus_row(index: Int) -> CorpusRow:

    if index == 0:
        return CorpusRow(
            "c0",
            gaussian_q(0, 1, 0, 1),
            1,
            gaussian_q(0, 1, 0, 1),
            gaussian_q(0, 1, 0, 1),
            MULT_SUPERATTRACTING,
            ORBIT_PREPERIODIC,
            0,
            1,
        )
    if index == 1:
        return CorpusRow(
            "basilica",
            gaussian_q(-1, 1, 0, 1),
            2,
            gaussian_q(0, 1, 0, 1),
            gaussian_q(-1, 1, 0, 1),
            MULT_SUPERATTRACTING,
            ORBIT_PREPERIODIC,
            0,
            2,
        )
    if index == 2:
        return CorpusRow(
            "dendrite",
            gaussian_q(0, 1, 1, 1),
            2,
            gaussian_q(-1, 1, 1, 1),
            gaussian_q(0, 1, -1, 1),
            MULT_REPELLING,
            ORBIT_PREPERIODIC,
            2,
            2,
        )
    if index == 3:
        return CorpusRow(
            "dendrite_conjugate",
            gaussian_q(0, 1, -1, 1),
            2,
            gaussian_q(-1, 1, -1, 1),
            gaussian_q(0, 1, 1, 1),
            MULT_REPELLING,
            ORBIT_PREPERIODIC,
            2,
            2,
        )
    if index == 4:
        return CorpusRow(
            "chebyshev",
            gaussian_q(-2, 1, 0, 1),
            1,
            gaussian_q(2, 1, 0, 1),
            gaussian_q(0, 1, 0, 1),
            MULT_REPELLING,
            ORBIT_PREPERIODIC,
            2,
            1,
        )
    if index == 5:
        return CorpusRow(
            "cauliflower",
            gaussian_q(1, 4, 0, 1),
            1,
            gaussian_q(1, 2, 0, 1),
            gaussian_q(0, 1, 0, 1),
            MULT_PARABOLIC,
            ORBIT_CAPPED,
            -1,
            -1,
        )
    if index == 6:
        return CorpusRow(
            "parabolic_minus_one",
            gaussian_q(-3, 4, 0, 1),
            1,
            gaussian_q(-1, 2, 0, 1),
            gaussian_q(0, 1, 0, 1),
            MULT_PARABOLIC,
            ORBIT_CAPPED,
            -1,
            -1,
        )
    if index == 7:
        return CorpusRow(
            "parabolic_i",
            gaussian_q(1, 4, 1, 2),
            1,
            gaussian_q(0, 1, 1, 2),
            gaussian_q(0, 1, 0, 1),
            MULT_PARABOLIC,
            ORBIT_CAPPED,
            -1,
            -1,
        )
    if index == 8:
        return CorpusRow(
            "niven",
            gaussian_q(37, 100, 4, 25),
            1,
            gaussian_q(3, 10, 2, 5),
            gaussian_q(0, 1, 0, 1),
            MULT_IRRATIONALLY_INDIFFERENT,
            ORBIT_CAPPED,
            -1,
            -1,
        )
    if index == 9:
        return CorpusRow(
            "escaping",
            gaussian_q(1, 1, 0, 1),
            0,
            gaussian_q(0, 1, 0, 1),
            gaussian_q(0, 1, 0, 1),
            MULT_NONE,
            ORBIT_ESCAPES,
            3,
            -1,
        )
    return CorpusRow("", gaussian_q(0, 1, 0, 1), 0, gaussian_q(0, 1, 0, 1), gaussian_q(0, 1, 0, 1), MULT_NONE, ORBIT_CAPPED, -1, -1)
