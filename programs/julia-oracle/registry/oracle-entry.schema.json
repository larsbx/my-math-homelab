{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:larsbx:julia-oracle-lab:oracle-entry:v1",
  "title": "Julia Oracle Registry Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "oracle_id",
    "version",
    "domain_repository",
    "claim_id",
    "checker_repository",
    "boundary_id",
    "exactness",
    "result_vocabulary"
  ],
  "properties": {
    "schema": {
      "const": "julia-oracle-entry/v1"
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domain_repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "checker_repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "exactness": {
      "enum": [
        "exact",
        "interval",
        "numerical",
        "mixed"
      ]
    },
    "result_vocabulary": {
      "type": "array",
      "prefixItems": [
        {
          "const": "agrees"
        },
        {
          "const": "disagrees"
        },
        {
          "const": "inconclusive"
        },
        {
          "const": "oracle_error"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "julia_compat": {
      "type": "string"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
